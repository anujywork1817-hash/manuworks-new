# The container runs as the non-root user `docassist` (UID 1001, set in the
# Dockerfile). Docker bind-mounts /var/app/storage from the host (see
# Dockerrun.aws.json), and a host directory created by Docker is owned by root —
# so the app would get EACCES on its first file upload.
#
# These commands run as root on the instance before each deploy. UID/GID 1001
# must stay in sync with the Dockerfile's `useradd -u 1001`.
#
# Only /var/app/storage is handled here. There is deliberately no host mount for
# /app/logs: the app logs to stdout (LOG_OUTPUT=stdout), which Docker and EB
# capture on their own. Mounting a log directory as well would collide with
# EB's own log mount — see the note in Dockerrun.aws.json history.
commands:
  01_create_storage_dir:
    command: "mkdir -p /var/app/storage"
  02_own_storage_dir:
    command: "chown -R 1001:1001 /var/app/storage"
  03_permit_storage_dir:
    command: "chmod -R 0775 /var/app/storage"
