# Elastic Beanstalk platform + application settings.
#
# NOTE: no secrets here — this file ships inside the deployment bundle.
# Set POSTGRES_PASSWORD, JWT_*_SECRET, GEMINI_API_KEY, OPENAI_API_KEY,
# GROQ_API_KEY etc. with `eb setenv` or in the EB console
# (Configuration -> Updates, monitoring, and logging -> Environment properties).

option_settings:
  # ── Instance sizing ────────────────────────────────────────────────────────
  # The Docker image is built ON the instance: it pulls the Go toolchain, apt-
  # installs Tesseract + Poppler, and compiles the binary. t3.micro (1 GB RAM)
  # runs out of memory during `go build`. t3.small is the practical minimum.
  aws:ec2:instances:
    InstanceTypes: t3.small

  aws:autoscaling:launchconfiguration:
    # Default 8 GB fills up fast: builder image + runtime image + tessdata.
    RootVolumeType: gp3
    RootVolumeSize: 30

  # ── Deployment ─────────────────────────────────────────────────────────────
  aws:elasticbeanstalk:command:
    # Default is 600s. A cold Docker build (toolchain + apt + tessdata) can
    # exceed that and EB will abort the deploy mid-build.
    Timeout: 1800

  # ── Health ─────────────────────────────────────────────────────────────────
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health

  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # ── Logs ───────────────────────────────────────────────────────────────────
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7

  # ── Non-secret application config ──────────────────────────────────────────
  aws:elasticbeanstalk:application:environment:
    APP_NAME: LexDocs
    APP_ENV: production
    APP_DEBUG: "false"
    PORT: "8080"

    LOG_LEVEL: info
    LOG_FORMAT: json
    LOG_OUTPUT: stdout
    LOG_FILE_PATH: /app/logs/app.log

    SWAGGER_ENABLED: "false"

    # RDS requires TLS.
    POSTGRES_SSL_MODE: require

    # Mounted from the host at /var/app/storage (see Dockerrun.aws.json), so
    # uploads survive redeploys on the same instance.
    STORAGE_TYPE: local
    STORAGE_LOCAL_PATH: /app/storage

    TESSERACT_PATH: /usr/bin/tesseract
    TESSERACT_LANG: eng

    # Mobile clients send no browser Origin; the app already allows all origins.
    CORS_ALLOWED_ORIGINS: "*"
